{
  "name": "servermon",
  "productName": "ServerMon",
  "version": "0.1.0",
  "description": "Real-time multi-cluster Kubernetes pod and Alibaba Cloud ECS monitor",
  "type": "module",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac --publish never",
    "mock:cluster": "node scripts/mock-k8s-server.mjs",
    "mock:aliyun": "node scripts/mock-aliyun-ecs-server.mjs",
    "verify:signature": "node --experimental-strip-types scripts/verify-aliyun-signature.ts",
    "test:e2e": "electron-vite build && node scripts/e2e.mjs",
    "demo:images": "electron-vite build && node scripts/capture-demo.mjs"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.2",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "author": "Enix Yu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enix223/servermon.git"
  }
}
